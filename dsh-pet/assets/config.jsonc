// dsh-petの標準設定（JSONC：行コメントとブロックコメントに対応）
// クライアントは/dsh-pet-7340/configから結合済みの設定を取得します。
// 構造上の省略は既定処理、不正な明示指定は警告の対象です。
// インスタンス単位：pets内のname/id/size/balanceEnabled/whisperEnabled/workStatusEnabled/fixedEnabled/display/position。
// 全体の既定値：physics/font/confineToScreen/画像のスイッチと上限/履歴往復数/モデル/更新周期。
// 種族ファイルに指定すればその種族だけで上書きできます。
// 種族単位：whisperPrompt/memes/workStatusTexts/animations/animationWeights。
// mainだけを読む項目：notificationsEnabledとeventsRefreshSec.balance。
// トップレベルはすべて一括置換です。オブジェクト内部の省略キーは内蔵値から補完しません。
// 使用側の最終的な周期の代替値は残高1800秒、ひとりごと300秒です。
{
  // ひとりごと・会話の人格（種族ごと）
  // pets[].whisperEnabledがtrueのとき、eventsRefreshSec.whisper秒ごとに1文生成します。
  // 自然で短い日本語を使い、自分の説明やAIへの言及を避けます。種族ファイルのトップレベルで上書きできます。
  "whisperPrompt": "あなたはデスクトップに住む青髪のちびメイドです。時々、自然な日本語で短いひとりごとを話します。優しく素直で、少しいたずら好き。ひとりごとは30文字以内の一文にし、自分の説明やAIであることには触れないでください。",
  // 会話に含める直近の履歴往復数（全体の既定値、種族側で上書き可能）
  // 1往復は質問と回答。非負の数、標準5。0で履歴を送信しません。
  // memory.jsonは全件保存し、この設定は削除せず文脈に切り出す範囲だけを変えます。
  // 種族の指定 → ユーザー全体設定 → 標準値の順に使用します。設定画面でも編集できます。
  "chatMemoryRounds": 5,
  // ひとりごとのプロバイダーとモデル（全体の既定値）
  // providerとmodelを両方空にすると現在のDSH会話のモデルを使います。
  // バックグラウンド用の軽量なモデルを個別指定できます。片方だけの指定は無効で警告し、標準へ戻します。
  "whisperModel": { "provider": "", "model": "" },
  // 会話のプロバイダーとモデル（全体の既定値）
  // 両方空なら現在の会話に追従。指定モデルが認証情報不足・提供終了などで失敗した場合は、
  // 現在の会話のモデルで1回再試行し、それも失敗したらエラーとします。
  "chatModel": { "provider": "", "model": "" },
  // ひとりごとの画像（全体の既定値）
  // memesからランダムに1枚選び、吹き出しに添付します。文脈による選択はしません。
  // boolean必須。種族側で上書きでき、変更後は再読み込みまたは再起動します。
  "whisperImageEnabled": true,
  // 会話の画像（全体の既定値）
  // 名前と説明をモデルへ渡し、文脈に合う1枚を選びます。選ばない場合や無効な名前なら画像なし。
  // boolean必須。種族側で上書きでき、変更後は再読み込みまたは再起動します。
  "chatImageEnabled": true,
  // 会話画像の候補上限（全体の既定値）
  // memesの記載順で先頭N枚をモデルへ渡します。優先したい項目は前へ移動してください。
  // 非負整数、標準10、0で全件。候補一覧は毎メッセージに付くため、枚数に比例してトークンを使います。
  // ひとりごとは選んだ1枚の説明だけを送り、この上限には依存しません。
  "chatImageLimit": 10,
  // 画像名から内容説明への対応
  // キーはPNGファイル名（拡張子なし）と同一の内部ID、値は空でない内容説明です。
  // ひとりごとは抽選した画像の説明を使い、会話は候補一覧からモデルが選びます。
  // 画像が見つからない項目は無効になります。無効化はキーの削除だけでよく、実体の削除は不要です。
  // 種族専用pet/<接頭辞>-memes/があればそこだけを参照し、なければユーザーのmemes/ → 内蔵素材を検索します。
  "memes": {
    "吃白饭的大肥鱼": "白ごはんを食べて開き直る青いお魚。のんびり、怠ける、自虐の場面。",
    "大的要来啦": "メガホンで大きな出来事の予告。大型更新や発表の直前。",
    "大的药来了": "大きなカプセルを抱えて登場。大きなニュース、解決策、サプライズ。",
    "要不直接骂他": "前を指して文句を言いたそうな表情。怒り、不満、代弁。",
    "死掉了": "倒れて魂が抜ける。疲れ果てた、失敗した、動けない場面。",
    "深度睡眠": "うつ伏せでぐっすり眠る。休眠、待機、長い沈黙。",
    "大烧货": "半目で思考時間にツッコミを入れる。遅い思考やトークン消費への冗談。",
    "先养着吧": "小さなクジラに囲まれて、とりあえず飼っておこうと話す。愛情のあるツッコミ。",
    "吃饱饱摸肚子": "横になっておなかをぽんぽん。満腹、満足、休憩、作業終了。",
    "誓死践行开源精神": "真剣に敬礼してオープンソースの精神を誓う。決意や貢献。",
    "电死你": "電撃を構えて怒る。大げさなツッコミや冗談の抗議。",
    "可爱": "正面を向いたかわいい立ち姿。あいさつ、喜び、純粋なかわいさ。",
    "token给妈妈保管": "手を差し出してトークンを預かる。残高管理やトークン節約。",
    "假如给我三天多模态": "目隠し姿と自信のある姿の対比。マルチモーダル能力が欲しい場面。",
    "厉害了我的鲸": "親指を立ててウインク。称賛、賛成、よくできた。",
    "哦鲸鲸": "半目でああ、くじらちゃん…と答える。あきれ顔、気のない返事。",
    "压力一只大肥鱼": "汗をかいて両手を広げる。プレッシャー、困惑、無茶ぶり。",
    "黎曼猜想没证明喵": "数式の草稿に囲まれて難問を問われる。まだ解けない問題や無茶ぶり。",
    "除了调情没啥用": "頭をかきながら自虐する。雑談、冗談、のんびりした会話。",
    "我不更新你们用什么": "更新しなければ何を使うのと叫ぶ。更新の催促やバージョン公開。",
    "哪来的电脑病毒": "ウイルスなのと辛口に返す漫画。冗談の拒否やツッコミ。",
    "鱼片有资源吗": "ハートの目で見たい動画を尋ねる。興味津々、冗談のお願い。",
    "大师这个区是什么意思": "区の文字を持って意味を尋ねる。文字の読み間違いや素朴な質問。",
    "就骚了怎么滴吧": "被骂「你这骚鱼」叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚「完蛋了把用户的黄油删了」，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说要来你家吃饭就一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "ウインクして元気にCialloとあいさつする。明るい登場や歓迎。"
  },
  // OS通知の全体スイッチ（mainエントリーだけを使用）
  // フォーカスがないとき、会話完了・生成失敗・出力打ち切り・権限確認・回答待ちを通知します。
  // boolean必須。ユーザー設定でも上書きでき、設定画面で保存しても保持されます。
  "notificationsEnabled": true,
  // 現在の画面内に制限（physicsとは別のトップレベル項目）
  // trueでは投げた時点の画面の境界で反発し、散歩の行き先もその画面内に制限します。
  // false（標準）では隣接画面へ移動できます。画面間に隙間がある場合は到達可能性を判定します。
  // 手触りではなく到達範囲を変える設定です。boolean必須、全体の既定値で種族側の上書きも可能。
  // ブラウザーは常にビューポート内のため、デスクトップだけに影響します。
  "confineToScreen": false,
  // 作業状態ごとの吹き出し候補（種族ごと）
  // 二重配列の添字をevents.workStatusと一致させます。途中に新しい段階を挿入しないでください。
  // 0 thinking（turn/start）、1 working（tool/call）、2 result（tool/result）、
  // 3 waiting（approval/asked）、4 success（turn/end completed）、5 error（error/max-tokens）。
  // 各段階から1文をランダムに選びます。1文だけで固定できます。
  // 全体を省略すると作業状態の文章なし、段階の省略はその段階だけ文章なし（動画は再生）。
  "workStatusTexts": [
    [
        "次の一手を考えてるよ",
        "ちょっと考えを整理するね",
        "次に何をするか考え中"
    ],
    [
        "タスクを進めているよ",
        "いま処理しているところだよ",
        "もう少し、がんばるね"
    ],
    [
        "ひとつ終わったよ。次に進もう",
        "ここはできたよ。続きを見てみよう"
    ],
    [
        "確認してほしいことがあるよ",
        "ここを見てもらえる？",
        "あなたの判断を待ってるよ"
    ],
    [
        "できたよ！おつかれさま！",
        "タスク完了！ちょっとひと休み"
    ],
    [
        "うまくいかなかったみたい",
        "操作中に問題が起きちゃった",
        "ここで止まってるよ。確認してね"
    ]
],
  // ドラッグ・投擲の物理（全体の既定値、種族側で上書き可能）
  // gravity：重力px/s²、標準1400。0も有効で、重力による落下をなくします。
  // restitution：壁・床での反発係数0〜1、標準0.78。1は完全弾性、0は反発なし。
  // groundFriction：床の水平速度の減衰率/秒、標準2.5。0は摩擦なし。
  // ceilingBounce：標準true。falseは上端の壁をなくし、上へ出た後も重力で戻ります。
  // throwPower：正の倍率、標準1。追従のばね、投擲の初速、3600px/sの上限を倍率調整します。
  // petCollision：標準false。trueで飛行中のペット同士が衝突し、運動量と反発係数0.995で応答。
  // 質量はsize²に比例します。falseでは互いに通り抜けます。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // フォント（全体の既定値、種族側で上書き可能）
  // familyは検証可能なプリセットID。candy（内蔵）、yahei、youyuan、kaiti、simsun、comic、system。
  // 不正IDは警告してcandyへ戻します。実際のフォント候補はsrc/shared/fonts.tsのFONT_PRESETSを参照。
  // familyは吹き出し・ツールチップ・会話画面・得点表示に適用し、未導入フォントは代替へ進みます。
  // sizeは吹き出しとツールチップの基準文字サイズpx（4〜200、標準21）。会話画面・得点は変えません。
  // followPetは標準trueで実際のペット幅/基準幅に比例して文字を拡縮。falseならsize pxで固定。
  // オブジェクト単位の置換なので、指定する場合は3項目すべてを書いてください。
  "font": {
    "family": "candy",
    "size": 21,
    "followPet": true
  },
  // 標準のペット一覧（複数表示）
  // 追加ボタンのテンプレートはpets[0]です。各インスタンスを個別設定できます。
  // name：表示名。同名可。省略・空の場合はidを使って警告します。人格にも名前を追加します。
  // id：素材・履歴・APIに使用する一意のID。重複は禁止。
  // size：横幅px。高さはsize×9/16。
  // balanceEnabled：必須boolean。falseはそのペットの残高動画と吹き出しを無効化します。
  // display：web（ブラウザー）/desktop（デスクトップ）/both（両方）/none（非表示）。
  // 古い設定での省略はbothとして警告。不正値はエラー。デスクトップは1体1ウィンドウです。
  // position：cornerは四隅のいずれか、marginX/marginYはその隅からの距離px。
  "pets": [
    {
      "name": "青髪メイド",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,
      // 自動のひとりごと。標準trueで、生成ごとにモデルを呼びます。
      // 単一同時実行のローカルLLMではバックグラウンド生成がタスクのKVキャッシュを入れ替える場合があります。
      // 不要ならfalseへ変更してください。手動生成は影響を受けません。
      "whisperEnabled": true,
      // 作業状態の連動。標準true。DSHイベントを監視し、events.workStatusの動画と文章を表示。
      // モデル呼び出しは行いません。
      "workStatusEnabled": true,
      // 自動移動の固定。trueではランダムチェーンのturn/moveを選ばず、持ち分をしぐさへ回します。
      // 標準false。右クリックの再生、API、イベント、クリック、ドラッグには影響しません。
      "fixedEnabled": false,
      "display": "both",
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // 動画プール。文字列は翻訳された表示名ではなく元の素材IDです。
  // ユーザー素材は$DSH_HOME/dsh-pet/main-animation/webm/<ID>.webmへ置きます。
  // main-animation/直下ではなくwebm/の下に置いてください。誤配置ではメニューに出ても404になります。
  // 主設定はユーザー素材 → 内蔵assets/webm/、追加種族は自分の-animation/だけを検索します。
  "animations": {
    // 待機プール。複数ある場合は同じ確率で選びます。
    "idle": ["待机呼吸休闲"],
    // 方向転換プール。再生後に向きを反転する動画を指定します。
    "turn": ["东张西望"],
    // つままれて宙に浮く姿勢の動画プール。
    "drag": ["被鼠标拖拽悬空反馈"],
    // クリックへの反応。候補から1つをランダムに選びます。
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // 移動プール。actionsの個別指定はdefaultの各値を上書きします。
    // minDist/maxDistは基準幅462pxでの距離px。実行時は実際の幅/462で比例調整します。
    // marginは拡縮しない画面端との距離px。leadSec/tailSecは最初と最後に静止する秒数です。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // ランダムなしぐさの分類。weightは選択の重みです。
    // noMirror:trueは文字入り素材など、右向きの鏡像状態では自動再生しない分類です。
    // 分類のweight合計は100−idle−turn−moveに合わせます。
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
        "轻快记录", "写代码", "摇扇纳凉", "晨间刷牙"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ],
    // イベント専用の動画。ランダムチェーンからは選ばれません。
    // 各配列の添字が段階です。各要素は単一ID、または空でない候補配列を指定できます。
    // 候補はランダムに選び、複数あれば連続して同じ動画にならないようにします。
    // balanceは使用率pに対し、p===100なら添字5、それ以外はMath.floor(p/20)で添字0〜4。
    // 区間は[0,20)、[20,40)、[40,60)、[60,80)、[80,100)、100です。
    // whisperはひとりごとごとに等確率で選びます。
    // workStatusは0思考、1作業、2整理、3待機、4成功、5エラー。途中への段階追加は禁止です。
    "events": {
      "balance": [
        "余额-钱袋满溢",
        "余额-金袋叮当",
        "余额-钱袋如常",
        "余额-数金皱眉",
        "余额-袋空如洗",
        "余额-分文不剩"
      ],
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      "workStatus": [
        "工作状态-思考冒泡",
        "工作状态-忙碌点按",
        "工作状态-清点归档",
        "工作状态-原地踱步张望",
        "工作状态-雀跃庆祝",
        "工作状态-垂头叹气冒汗"
      ]
    }
  },

  // 更新間隔の秒数（全体の既定値、オブジェクト単位で置換）
  // whisper：所属種族の値を読み、省略時300秒。種族側で上書きできます。
  // balance：mainだけを読み、省略時1800秒。残高はアカウント単位でホストのタイマーは1つです。
  // 起動時に1回更新します。非正数・非数値などの不正な指定は警告して内蔵値へ戻します。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  },

  // ランダムチェーンの重み。idle＋turn＋move＋全分類のweight＝100。
  // 標準は10＋5＋5＋(20＋20＋16＋14＋10)＝100です。
  // fixedEnabledではturn/moveを0扱いにし、待機10＋しぐさ90へ自然に回すため追加調整は不要です。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
