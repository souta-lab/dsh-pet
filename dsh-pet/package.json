{
  "name": "dsh-pet",
  "version": "0.3.7-ja.1",
  "description": "DSHのデスクトップペット日本語版。設定・メニュー・通知・チャット・ひとりごとに対応。",
  "icon": "assets/logo.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "web-ui",
    "cordis",
    "react"
  ],
  "homepage": "https://github.com/PC2005-cloud/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC2005-cloud/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/PC2005-cloud/dsh-pet/issues"
  },
  "_comment": [
    "=============== dsh-petパッケージ設定の説明 ===============",
    "type: module：ESM形式のパッケージ。",
    "main: lib/index.js：Cordisホストプラグインの入口（name/inject/apply）。",
    "icon：プラグイン管理画面の画像。package.jsonからの相対パスでsvg/png/jpg/jpeg/webp、256KiB以下。realpathはパッケージ内に限定。dsh-app-bootのiconOfがbase64 data URLとしてmeta.iconへ格納。",
    "exports['./client']：ブラウザー側の入口。DSHが/plugins/dsh-pet/client.jsとして提供。",
    "dsh.bundle.patch：bundleと宣言し、cordis.patch.ymlをインストール後のレイヤーへ追加。",
    "dsh.client：ブラウザー側の依存注入とwebプラットフォームを宣言。",
    "dsh.compatibility.dshReleases：公式の完全なDSHバージョンごとにcompatible/incompatible/unknownを宣言。広い範囲だけの指定は検証根拠にならず、ストアの直近3版に少なくとも1つのcompatibleが必要。",
    "files：npmへ配布するファイル。assets/webmのVP9-Alpha素材をブラウザーとデスクトップで共有。Safari用HEVCは別の変換工程を利用。README用のpreview GIFはパッケージに含めない。",
    "scripts.encode:webm：step03のマスターから640×360のassets/webmを作成。",
    "scripts.build：node scripts/prepare.jsで全成果物と配布一覧を生成。clone後は手動実行、npm publish/packはprepackから自動実行。",
    "scripts.prepack：build → typecheck/lint/format → prepack-check → check:openapi。prepare.jsは配布対象外のため、インストール時のprepareへビルドを登録しない。",
    "bin.dsh-pet-standalone：lib/standalone.jsでDSHなしの単独起動。擬似ctxでホスト処理を実行。tsdownの第2エントリーがsrc/standalone/をビルド。",
    "peerDependencies：実行時にDSHが提供するモジュール。本パッケージへは組み込まない。",
    "engines：Node.jsの最低対応バージョン。実行依存の@electron/get@5.1.0の要件に基づく。",
    "================================================"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-pet-standalone": "lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/config.jsonc",
    "assets/logo.png",
    "scripts/ensure-electron.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "standalone": "node lib/standalone.js",
    "dev:mock": "node scripts/dev/mock-server.mjs",
    "build": "node scripts/prepare.js",
    "prepack": "npm run build && npm run typecheck && npm run lint && npm run format:check && node scripts/prepack-check.js && npm run check:openapi",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "types": "node scripts/gen-types.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
